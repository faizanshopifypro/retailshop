{
  "sections": {
    "sr_hero": {
      "type": "sr-hero",
      "blocks": {
        "slide_1": { "type": "slide", "settings": {} },
        "slide_2": { "type": "slide", "settings": {} },
        "slide_3": { "type": "slide", "settings": {} }
      },
      "block_order": ["slide_1", "slide_2", "slide_3"],
      "settings": {
        "label": "NEW ARRIVALS",
        "heading": "Style Better.\nLive Better.",
        "subheading": "Discover premium products, handpicked for your lifestyle.",
        "button_label": "Shop Now",
        "button_link": "shopify://collections/all",
        "button2_label": "Explore Collections",
        "button2_link": "shopify://collections/all",
        "show_badge": true,
        "badge_top": "Up to",
        "badge_num": "50%",
        "badge_bottom": "OFF"
      }
    },
    "sr_categories": {
      "type": "sr-categories",
      "blocks": {
        "cat_1": { "type": "category", "settings": { "title": "Women", "link": "shopify://collections/all" } },
        "cat_2": { "type": "category", "settings": { "title": "Men", "link": "shopify://collections/all" } },
        "cat_3": { "type": "category", "settings": { "title": "Footwear", "link": "shopify://collections/all" } },
        "cat_4": { "type": "category", "settings": { "title": "Bags", "link": "shopify://collections/all" } },
        "cat_5": { "type": "category", "settings": { "title": "Accessories", "link": "shopify://collections/all" } },
        "cat_6": { "type": "category", "settings": { "title": "Home", "link": "shopify://collections/all" } },
        "cat_7": { "type": "category", "settings": { "title": "Deals", "link": "shopify://collections/all" } }
      },
      "block_order": ["cat_1", "cat_2", "cat_3", "cat_4", "cat_5", "cat_6", "cat_7"],
      "settings": {
        "heading": "Shop by Category"
      }
    },
    "sr_featured": {
      "type": "sr-featured-products",
      "settings": {
        "heading": "Featured Products",
        "products_to_show": 6,
        "view_all_label": "View all products",
        "view_all_link": "shopify://collections/all",
        "show_quick_add": true
      }
    },
    "sr_delivery": {
      "type": "sr-delivery",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Order placed",
            "text": "Checkout is encrypted. You get a confirmation as soon as your order is in."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Packed with care",
            "text": "Each item is checked and packed so it arrives ready to use."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "Shipped fast",
            "text": "Carriers pick up on schedule. Tracking is sent as soon as the label prints."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "At your door",
            "text": "Most destinations receive orders within a few business days."
          }
        }
      },
      "block_order": ["step_1", "step_2", "step_3", "step_4"],
      "settings": {
        "heading": "From our warehouse to your door",
        "subheading": "Free shipping on orders $50+. Most orders leave the same or next business day."
      }
    },
    "sr_benefits": {
      "type": "sr-benefits",
      "blocks": {
        "b1": { "type": "benefit", "settings": { "title": "Free Shipping", "text": "On orders $50+" } },
        "b2": { "type": "benefit", "settings": { "title": "Easy Returns", "text": "30-day hassle-free returns" } },
        "b3": { "type": "benefit", "settings": { "title": "Secure Checkout", "text": "Encrypted payments" } },
        "b4": { "type": "benefit", "settings": { "title": "Support", "text": "We're here to help" } }
      },
      "block_order": ["b1", "b2", "b3", "b4"],
      "settings": {}
    },
    "sr_process": {
      "type": "sr-process",
      "blocks": {
        "p1": {
          "type": "point",
          "settings": {
            "title": "Curated selection",
            "text": "We only list products we would buy ourselves—gadgets, beauty, and everyday essentials in one shop."
          }
        },
        "p2": {
          "type": "point",
          "settings": {
            "title": "Quality checked",
            "text": "Items are inspected before they ship so what you see on the page is what arrives."
          }
        },
        "p3": {
          "type": "point",
          "settings": {
            "title": "Packed with care",
            "text": "Secure packaging, clear tracking, and support if anything is not right."
          }
        }
      },
      "block_order": ["p1", "p2", "p3"],
      "settings": {
        "heading": "A process you can trust",
        "intro": "Every order follows the same path: curated products, a quality check, and careful packing before it leaves our warehouse."
      }
    },
    "sr_reviews": {
      "type": "sr-reviews",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "quote": "I noticed a difference within the first week. The quality is amazing and it has quickly become part of my daily routine.",
            "name": "Sarah M.",
            "meta": "Verified Customer",
            "verified": true
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "quote": "The product feels premium, works exactly as described, and shipping was incredibly fast.",
            "name": "James R.",
            "meta": "Verified Customer",
            "verified": true
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "Beautiful packaging and a really great experience from start to finish.",
            "name": "Ava L.",
            "meta": "Verified Customer",
            "verified": true
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "quote": "Checkout was simple, delivery landed ahead of schedule, and the item matched the listing exactly.",
            "name": "Chris P.",
            "meta": "Verified Customer",
            "verified": true
          }
        }
      },
      "block_order": ["r1", "r2", "r3", "r4"],
      "settings": {
        "eyebrow": "CUSTOMER REVIEWS",
        "heading": "LOVED BY\nTHOUSANDS.",
        "rating": "4.9",
        "rating_caption": "Based on 328 reviews"
      }
    },
    "sr_faq": {
      "type": "sr-faq",
      "blocks": {
        "f1": {
          "type": "item",
          "settings": {
            "question": "Where do you ship to?",
            "answer": "We ship to supported destinations worldwide. Availability and delivery times are shown during checkout."
          }
        },
        "f2": {
          "type": "item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "Most orders leave the same or next business day. Typical delivery is a few business days."
          }
        },
        "f3": {
          "type": "item",
          "settings": {
            "question": "Is shipping free?",
            "answer": "Yes. Orders $50 and over include free shipping."
          }
        },
        "f4": {
          "type": "item",
          "settings": {
            "question": "Can I return my order?",
            "answer": "Yes. Eligible products can be returned within 30 days."
          }
        }
      },
      "block_order": ["f1", "f2", "f3", "f4"],
      "settings": {
        "heading": "Frequently asked questions"
      }
    },
    "sr_newsletter": {
      "type": "sr-newsletter",
      "settings": {
        "heading": "Join Our Newsletter",
        "text": "Get 10% off on your first order!",
        "placeholder": "Enter your email address",
        "button_label": "Subscribe"
      }
    }
