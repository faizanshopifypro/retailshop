{{ 'sr-product.css' | asset_url | stylesheet_tag }}
{% render 'sr-theme-tokens' %}

<div class="sr-theme" {{ section.shopify_attributes }}>
  <section class="results-section">
    <div class="results-container">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="results-grid">
        {% for block in section.blocks %}
          <article class="result-card" {{ block.shopify_attributes }}>
            <div class="pct">{{ block.settings.stat }}</div>
            <p>{{ block.settings.text }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SR Results",
  "tag": "section",
  "class": "sr-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real results" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "stat", "label": "Stat", "default": "94%" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "saw visible improvement within 2 weeks" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SR Results",
      "category": "ShopRetail",
      "blocks": [
        { "type": "stat", "settings": { "stat": "94%", "text": "saw visible improvement within 2 weeks" } },
        { "type": "stat", "settings": { "stat": "89%", "text": "would recommend to a friend" } },
        { "type": "stat", "settings": { "stat": "4.9", "text": "average customer rating" } }
      ]
    }
  ]
}
{% endschema %}
