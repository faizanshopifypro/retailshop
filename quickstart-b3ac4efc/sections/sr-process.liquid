{{ 'sr-home.css' | asset_url | stylesheet_tag }}
{{ 'sr-product.css' | asset_url | stylesheet_tag }}
{% render 'sr-theme-tokens' %}

<div class="sr-theme" {{ section.shopify_attributes }}>
  <section class="image-content-section home-process">
    <div class="image-content-container">
      <div class="image-content-image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}
      </div>
      <div class="image-content-content">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.intro != blank %}
          <p class="image-content-intro">{{ section.settings.intro }}</p>
        {% endif %}
        {% for block in section.blocks %}
          <div class="image-content-point" {{ block.shopify_attributes }}>
            <span class="image-content-point-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SR Trusted process",
  "tag": "section",
  "class": "sr-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A process you can trust" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Every order follows the same path: curated products, a quality check, and careful packing before it leaves our warehouse." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Curated selection" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We only list products we would buy ourselves." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SR Trusted process",
      "category": "ShopRetail",
      "blocks": [
        { "type": "point", "settings": { "title": "Curated selection", "text": "We only list products we would buy ourselves—gadgets, beauty, and everyday essentials in one shop." } },
        { "type": "point", "settings": { "title": "Quality checked", "text": "Items are inspected before they ship so what you see on the page is what arrives." } },
        { "type": "point", "settings": { "title": "Packed with care", "text": "Secure packaging, clear tracking, and support if anything is not right." } }
      ]
    }
  ]
}
{% endschema %}
