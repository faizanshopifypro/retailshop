{{ 'sr-product.css' | asset_url | stylesheet_tag }}
{% render 'sr-theme-tokens' %}

<div class="sr-theme" {{ section.shopify_attributes }}>
  <section class="image-content-section everyday-section{% if section.settings.reverse %} image-content-section-two{% endif %}">
    <div class="{% if section.settings.reverse %}image-content-container-two{% else %}image-content-container{% endif %}">
      {% unless section.settings.reverse %}
        <div class="image-content-image">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
      {% endunless %}
      <div class="image-content-content">
        <h2>{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <span>{{ section.settings.heading_italic }}</span>{% endif %}</h2>
        {% if section.settings.intro != blank %}
          <p class="image-content-intro">{{ section.settings.intro }}</p>
        {% endif %}
        {% for block in section.blocks %}
          <div class="image-content-point" {{ block.shopify_attributes }}>
            <span class="image-content-point-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.reverse %}
        <div class="image-content-image">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SR Everyday / Quality",
  "tag": "section",
  "class": "sr-section",
  "settings": [
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "MADE FOR YOUR" },
    { "type": "text", "id": "heading_italic", "label": "Heading italic line", "default": "EVERYDAY" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Thoughtfully designed to fit seamlessly into your daily routine." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Thoughtfully Formulated" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every ingredient has a purpose." }
      ]
    }
  ],
  "presets": [
    {
      "name": "SR Everyday",
      "category": "ShopRetail",
      "blocks": [
        { "type": "point", "settings": { "title": "Thoughtfully Formulated", "text": "Every ingredient has a purpose, carefully selected to support your everyday routine." } },
        { "type": "point", "settings": { "title": "Simple & Effective", "text": "A straightforward approach without unnecessary ingredients." } },
        { "type": "point", "settings": { "title": "Made For Real Life", "text": "Easy to add to your day, wherever life takes you." } }
      ]
    }
  ]
}
{% endschema %}
